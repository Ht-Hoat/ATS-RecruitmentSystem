  //  Để trống -> hệ thống tự chấm điểm bằng thuật toán offline (vẫn chạy).
  "Gemini": {
    "ApiKey": "DAN_API_KEY_GEMINI_CUA_BAN_VAO_DAY",
    "Model": "gemini-1.5-flash"
  },

  // ---- (2) SMTP gửi email THẬT (BẬT tính năng "tự động gửi mật khẩu vào mail") ----
  //  KHI ĐIỀN ĐỦ Host + From: đặt lại mật khẩu / duyệt HR / đổi trạng thái đơn
  //  sẽ GỬI THẲNG email cho tài khoản, và mật khẩu tạm KHÔNG còn hiện ra màn hình.
  //  Để trống -> hệ thống chạy "chế độ không gửi" và hiện mật khẩu tạm cho Admin đọc.
  //
  //  Ví dụ dùng Gmail (khuyến nghị cho đồ án):
  //    1. Bật xác thực 2 bước cho Gmail.
  //    2. Tạo "App password" 16 ký tự: https://myaccount.google.com/apppasswords
  //    3. Điền: User = email Gmail, Password = App password vừa tạo.
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": "587",
    "EnableSsl": "true",
    "User": "tai-khoan-gui@gmail.com",
    "Password": "APP_PASSWORD_16_KY_TU",
    "From": "tai-khoan-gui@gmail.com"
  }
