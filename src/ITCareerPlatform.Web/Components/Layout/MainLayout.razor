@inherits LayoutComponentBase
@inject INotificationService Notifs

<div class="app">
    <aside class="sidebar">
        <div class="brand">IT Career<span>PLATFORM</span></div>
        <AuthorizeView>
            <Authorized>
                <nav>
                    <a href="/">Trang chủ</a>

                    <AuthorizeView Roles="@Roles.Admin" Context="a">
                        <a href="/users">Quản lý tài khoản</a>
                        <a href="/audit">Nhật ký hệ thống</a>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Roles.AdminOrMentor" Context="h">
                        <a href="/jobs">Tin tuyển dụng IT</a>
                        <a href="/dashboard">Thống kê</a>
                    </AuthorizeView>

                    @* "Hồ sơ của tôi" không còn ở đây: nó thuộc về TÀI KHOẢN, nên nằm trong menu tài
                       khoản ở góc dưới — cùng chỗ với đổi mật khẩu và đăng xuất. *@
                    <AuthorizeView Roles="@Roles.Student" Context="c">
                        <a href="/positions">Việc làm IT</a>
                        <a href="/my-applications">Đơn của tôi</a>
                    </AuthorizeView>
                </nav>

                <div class="userbox">
                    @{
                        var uid = int.TryParse(context.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id) ? id :
                    0;
                        var roleName = context.User.FindFirst(ClaimTypes.Role)?.Value ?? "";
                    }
                    @if (roleName == Roles.Student && uid > 0)
                    {
                        var unread = Notifs.CountUnread(uid);
                        var items = Notifs.GetForUser(uid, 8);
                        <details class="bell">
                            <summary>🔔 Thông báo @if (unread > 0) {
                                <span class="badge-dot">@unread</span>
                            }
                        </summary>
                        <div class="bell-list">
                            @if (items.Count == 0)
                            {
                                <div class="bell-empty">Chưa có thông báo.</div>
                            }
                            @foreach (var n in items)
                            {
                                <form method="post" action="@($"/notifications/{n.Id}/read")"
                                      class="bell-item @(n.IsRead ? "" : "unread")">
                                    <input type="hidden" name="link" value="@n.Link" />
                                    <button type="submit">
                                        <b>@n.Title</b>
                                        <span>@n.Message</span>
                                        <i>@n.CreatedAt.ToString("dd/MM HH:mm")</i>
                                    </button>
                                </form>
                            }
                        </div>
                    </details>
                }
                <div class="uname">@context.User.Identity?.Name</div>
                <div class="urole">@Roles.Display(roleName)</div>
                <form method="post" action="/account/logout"><button class="btn-out" type="submit">Đăng
                    xuất</button></form>
                </div>
            </Authorized>
        </AuthorizeView>
    </aside>
    <main class="content">
        @Body
    </main>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string roleName = "";
    private bool showBell;
    private int unread;
    private List<Notification> items = new();

    // Hai truy vấn thông báo trước đây nằm thẳng trong markup, nên chúng chạy lại mỗi lần
    // render mọi trang sinh viên, kể cả những trang vốn không đọc CSDL.
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        roleName = CurrentUser.RoleName(user);

        var uid = CurrentUser.Id(user);
        // P0-4: Bật chuông thông báo cho mọi vai trò đã đăng nhập (để Mentor nhận thông báo khi SV rút đơn)
        showBell = user.Identity?.IsAuthenticated == true && uid > 0;
        if (!showBell) return;

        items = Notifs.GetForUser(uid, 8);
        unread = Notifs.CountUnread(uid);
    }

    /// <summary>Hai chữ cái đầu cho ô avatar: "Phạm Thị Lan" → "PL" (chữ đầu của họ và của tên).</summary>
    private static string Initials(string? fullName)
    {
        var parts = (fullName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant()
        };
    }
}
