@inherits LayoutComponentBase
@inject INotificationService Notifs

<div class="app">
    <aside class="sidebar">
        <div class="brand">IT Career<span>PLATFORM</span></div>
        <AuthorizeView>
            <Authorized>
                <nav>
                    <a href="/">Trang chủ</a>

                    <AuthorizeView Roles="@Roles.Admin" Context="a">
                        <a href="/users">Quản lý tài khoản</a>
                        <a href="/audit">Nhật ký hệ thống</a>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Roles.AdminOrMentor" Context="h">
                        <a href="/jobs">Tin tuyển dụng IT</a>
                        <a href="/dashboard">Thống kê</a>
                    </AuthorizeView>

                    <AuthorizeView Roles="@Roles.Student" Context="c">
                        <a href="/positions">Việc làm IT</a>
                        <a href="/profile">Hồ sơ của tôi</a>
                        <a href="/my-applications">Đơn của tôi</a>
                        <div class="nav-group">Tài nguyên IT</div>
                        <a href="/resources">Cổng tuyển dụng</a>
                        <a href="/toolkit">Roadmap & Checklist</a>
                    </AuthorizeView>
                </nav>

                <div class="userbox">
                    @if (showBell)
                    {
                        <details class="bell">
                            <summary>🔔 Thông báo @if (unread > 0) { <span class="badge-dot">@unread</span> }</summary>
                            <div class="bell-list">
                                @if (items.Count == 0)
                                {
                                    <div class="bell-empty">Chưa có thông báo.</div>
                                }
                                @foreach (var n in items)
                                {
                                    @* Chỉ gửi id. Đường dẫn chuyển tới được đọc từ CSDL ở phía server —
                                       trước đây nó là một ô ẩn trong form, tức là do client quyết định. *@
                                    <form method="post" action="@($"/notifications/{n.Id}/read")" class="bell-item @(n.IsRead ? "" : "unread")">
                                        <button type="submit">
                                            <b>@n.Title</b>
                                            <span>@n.Message</span>
                                            <i>@Ui.ShortDateTimeText(n.CreatedAt)</i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </details>
                    }
                    <div class="uname">@context.User.Identity?.Name</div>
                    <div class="urole">@Roles.Display(roleName)</div>
                    @* N1.A: nằm ngoài mọi AuthorizeView theo vai trò — cả ba vai trò đều đổi được. *@
                    <a class="userlink" href="/change-password">🔑 Đổi mật khẩu</a>
                    <form method="post" action="/account/logout"><button class="btn-out" type="submit">Đăng xuất</button></form>
                </div>
            </Authorized>
        </AuthorizeView>
    </aside>
    <main class="content">
        @Body
    </main>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string roleName = "";
    private bool showBell;
    private int unread;
    private List<Notification> items = new();

    // Hai truy vấn thông báo trước đây nằm thẳng trong markup, nên chúng chạy lại mỗi lần
    // render mọi trang sinh viên — kể cả /toolkit và /cv-templates vốn không đọc CSDL.
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        roleName = CurrentUser.RoleName(user);

        var uid = CurrentUser.Id(user);
        // P0-4: Bật chuông thông báo cho mọi vai trò đã đăng nhập (để Mentor nhận thông báo khi SV rút đơn)
        showBell = user.Identity?.IsAuthenticated == true && uid > 0;
        if (!showBell) return;

        items = Notifs.GetForUser(uid, 8);
        unread = Notifs.CountUnread(uid);
    }
}
