@* Thẻ hiển thị "Đánh giá độ phù hợp & Gợi ý lộ trình" (ATS-13/14).
   Dùng chung cho Mentor (ApplicantDetail) và Sinh viên (MyApplicationDetail). *@

@if (Eval.HasEvaluation)
{
    <div class="ai-eval">
        <div class="score-circle @Ui.ScoreClass(Eval.Score)">
            <span class="score-num">@Eval.Score%</span>
            <span class="score-cap">Phù hợp</span>
        </div>
        <div class="ai-eval-detail">
            <div class="ai-line ai-strength"><b>✅ Điểm mạnh:</b> @Eval.Strengths</div>
            <div class="ai-line ai-missing"><b>❌ Thiếu sót:</b> @Eval.Missing</div>
            <div class="ai-line ai-roadmap"><b>🚀 Lộ trình gợi ý:</b> @Eval.Roadmap</div>
        </div>
    </div>

    @* Nguồn của điểm được nói thẳng. Trước đây một lần Gemini lỗi (hoặc chưa cấu hình key)
       cho ra con số trông y hệt một lần chấm thành công, nên không ai phân biệt được
       kết quả mô hình với kết quả đối chiếu từ khóa. *@
    @if (Eval.IsOffline)
    {
        <p class="sub warn-note">
            📴 Điểm này do <b>công thức đối chiếu Tech Stack ngoại tuyến</b> tính, không phải mô hình AI
            (chưa cấu hình khóa Gemini, hoặc lần gọi vừa rồi thất bại). Chỉ nên xem là ước lượng thô.
        </p>
    }
    else if (ForStudent)
    {
        <p class="sub warn-note">💡 Đây là gợi ý tham khảo từ AI để bạn cải thiện hồ sơ — không phải quyết định tuyển dụng cuối cùng.</p>
    }
    else
    {
        <p class="sub warn-note">⚠️ AI chỉ hỗ trợ tham khảo — quyết định cuối cùng thuộc về bạn (Human-in-the-loop).</p>
    }
}
else
{
    <p class="sub">Chưa có đánh giá cho hồ sơ này.</p>
}

@code {
    [Parameter, EditorRequired] public AiResult Eval { get; set; } = default!;
    [Parameter] public bool ForStudent { get; set; }
}
