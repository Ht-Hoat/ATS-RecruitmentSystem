@page "/"
@attribute [Authorize]
@inject IUserService Users
@inject IJobService Jobs
@inject IApplicationService Applications

<h1 class="page-title">Trang chủ</h1>
<p class="sub">Xin chào <b>@name</b> — vai trò <b>@Roles.Display(role)</b>.</p>

@if (role == Roles.Student)
{
    <div class="cards">
        <div class="card"><div class="num">@openJobs</div><div class="lbl">Việc làm IT đang tuyển</div></div>
        <div class="card"><div class="num">@myApps</div><div class="lbl">Đơn đã nộp</div></div>
    </div>
    <div class="panel">
        <h2>Bắt đầu tìm việc IT</h2>
        <ul class="feat">
            <li><a href="/profile">Hoàn thiện hồ sơ IT & tải CV</a> — GitHub, LinkedIn, Portfolio, Tech Skills (ATS-08, 09)</li>
            <li><a href="/positions">Xem & lọc việc làm IT theo Category / Tech Stack / Level</a> rồi ứng tuyển (ATS-07, 10)</li>
            <li><a href="/my-applications">Theo dõi trạng thái đơn ứng tuyển</a></li>
            <li><a href="/toolkit">Roadmap & Checklist kỹ năng IT</a> · <a href="/cv-templates">Mẫu CV IT</a></li>
        </ul>
    </div>
}
else
{
    <div class="cards">
        <div class="card"><div class="num">@totalUsers</div><div class="lbl">Tài khoản</div></div>
        <div class="card"><div class="num">@openJobs</div><div class="lbl">Tin đang mở</div></div>
        <div class="card"><div class="num">@totalApps</div><div class="lbl">Tổng đơn ứng tuyển</div></div>
        <div class="card"><div class="num">@totalJobs</div><div class="lbl">Tổng tin tuyển dụng</div></div>
    </div>
    <div class="panel">
        <h2>Công cụ cho Mentor / HR IT</h2>
        <ul class="feat">
            <li><a href="/jobs">Quản lý tin tuyển dụng IT</a> — tạo/sửa với Category, Tech Stack, Level (ATS-04, 05, 06)</li>
            <li>Xem danh sách ứng viên, <b>AI đánh giá độ phù hợp & gợi ý lộ trình</b> và xếp hạng (ATS-11→15)</li>
            <li>Điều chỉnh điểm (Human-in-the-loop), đổi trạng thái 5 bước (ATS-16, 17)</li>
            <li><a href="/dashboard">Xem Dashboard thống kê & biểu đồ</a> (ATS-18)</li>
        </ul>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private string name = "", role = "";
    private int myApps, totalApps, totalUsers, totalJobs, openJobs;

    // Bốn ô số này trước đây được tính ngay trong markup bằng Users.GetAll().Count và
    // Jobs.GetAll() gọi HAI lần — tức là ba lần quét bảng đầy đủ, kèm dựng entity cho
    // từng dòng, trên chính trang mọi người mở ngay sau khi đăng nhập.
    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var u = (await AuthState).User;
        name = u.Identity?.Name ?? "";
        role = CurrentUser.RoleName(u);

        openJobs = Jobs.CountOpen();

        if (role == Roles.Student)
        {
            var uid = CurrentUser.Id(u);
            if (uid > 0) myApps = Applications.AppliedJobIds(uid).Count;
        }
        else
        {
            totalUsers = Users.CountAll();
            totalJobs = Jobs.CountAll();
            totalApps = Applications.CountAll();
        }
    }
}
