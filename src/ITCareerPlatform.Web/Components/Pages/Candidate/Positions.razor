@page "/positions"
@attribute [Authorize(Roles = Roles.Student)]
@inject IJobService Jobs
@inject IProfileService Profiles
@inject IApplicationService Applications

@* Xem + lọc việc IT · Ứng tuyển *@

<h1 class="page-title">Việc làm IT</h1>
<p class="sub">Lọc theo Chuyên ngành / Tech Stack / Cấp bậc / Mức lương / Hình thức / Địa điểm rồi ứng tuyển.</p>

@* Thành công và thất bại đi về hai tham số khác nhau: gộp chung thì một lời từ chối
   ("Tin tuyển dụng đã quá hạn nộp hồ sơ") hiện ra trong khung báo thành công màu xanh. *@
@if (!string.IsNullOrEmpty(Msg)) { <div class="alert-ok">@Msg</div> }
@if (!string.IsNullOrEmpty(Err)) { <div class="alert-err">@Err</div> }
@if (!hasProfile)
{
    <div class="alert-err">Bạn chưa có hồ sơ IT. Hãy <a href="/profile">tạo hồ sơ + tải CV</a> trước khi ứng tuyển.</div>
}
else if (!hasCv)
{
    <div class="alert-err">Bạn chưa tải CV. Hãy <a href="/profile">tải CV lên</a> để có thể ứng tuyển.</div>
}

<form method="get" action="/positions" class="filter-bar">
    <div>
        <label>Chuyên ngành</label>
        <select name="category">
            <option value="Tất cả">Tất cả</option>
            @foreach (var c in Job.Categories)
            {
                <option value="@c" selected="@(c == Category)">@c</option>
            }
        </select>
    </div>
    <div>
        <label>Cấp bậc</label>
        <select name="level">
            <option value="Tất cả">Tất cả</option>
            @foreach (var l in Job.Levels)
            {
                <option value="@l" selected="@(l == Level)">@l</option>
            }
        </select>
    </div>
    <div>
        <label>Hình thức</label>
        <select name="employmentType">
            <option value="Tất cả">Tất cả</option>
            @foreach (var et in Job.EmploymentTypes)
            {
                <option value="@et" selected="@(et == EmploymentType)">@et</option>
            }
        </select>
    </div>
    <div>
        <label>Tech Stack</label>
        <input name="tech" value="@Tech" placeholder="React, Python, Docker..." />
    </div>
    <div>
        <label>Địa điểm</label>
        <input name="location" value="@Location" placeholder="Hà Nội, TP.HCM..." />
    </div>
    <div>
        <label>Lương tối đa từ (tr)</label>
        <input name="minSalary" type="number" step="1" value="@MinSalary" placeholder="15" />
    </div>
    <div>
        <label>Sắp xếp</label>
        <select name="sort">
            <option value="new" selected="@(Sort != "deadline")">Mới nhất</option>
            <option value="deadline" selected="@(Sort == "deadline")">Hạn nộp gần nhất</option>
        </select>
    </div>
    <div class="filter-actions">
        <button class="btn-primary" type="submit">Tìm kiếm</button>
        <a class="btn" href="/positions">Xóa lọc</a>
    </div>
</form>

<p class="sub">Tìm thấy <b>@jobs.Count</b> việc làm phù hợp.</p>

<div class="job-grid">
    @foreach (var j in jobs)
    {
        var daysLeft = (j.Deadline.Date - VietnamDateHelper.Today()).Days;
        <div class="job-card">
            <div class="job-card-head">
                <span class="@Ui.CategoryClass(j.Category)">@j.Category</span>
                <span class="@Ui.LevelClass(j.Level)">@j.Level</span>
                <span class="chip">@j.EmploymentType</span>
            </div>
            <h3><a href="@($"/positions/{j.Id}")" style="color: inherit; text-decoration: none;">@j.Title</a></h3>
            <div class="job-tags">
                @foreach (var t in j.TechStackList)
                {
                    <span class="chip">@t</span>
                }
            </div>
            <div class="job-meta">
                <span>📍 @j.Location</span>
                <span>💰 @Ui.SalaryText(j.SalaryMin, j.SalaryMax)</span>
                <span class="@(daysLeft <= 7 ? "deadline-hot" : "")">⏰ @Ui.DateText(j.Deadline)@(daysLeft <= 7 ? $" (còn {daysLeft} ngày)" : "")</span>
                <span>👥 @counts.GetValueOrDefault(j.Id) ứng viên</span>
            </div>
            <div class="job-card-foot">
                @if (appliedStatus.TryGetValue(j.Id, out var status))
                {
                    if (status == ApplicationStatus.Withdrawn)
                    {
                        <span class="muted">🛑 Đã rút đơn</span>
                    }
                    else
                    {
                        <span class="ok">✔ Đã ứng tuyển</span>
                    }
                }
                else if (!hasProfile || !hasCv)
                {
                    <a class="btn-sm ghost" href="/profile">Hoàn thiện hồ sơ để ứng tuyển</a>
                }
                else
                {
                    <form method="post" action="@($"/jobs/{j.Id}/apply")" class="inline" onsubmit="return confirm('Bạn chắc chắn muốn ứng tuyển vị trí này? CV hiện tại sẽ được gắn vào đơn.');">
                        <button class="btn-sm" type="submit">Ứng tuyển ngay</button>
                    </form>
                }
            </div>
        </div>
    }
    @if (jobs.Count == 0)
    {
        <p class="sub">Không tìm thấy việc làm phù hợp với bộ lọc.</p>
    }
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Msg { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }
    [SupplyParameterFromQuery(Name = "category")] public string? Category { get; set; }
    [SupplyParameterFromQuery(Name = "level")] public string? Level { get; set; }
    [SupplyParameterFromQuery(Name = "tech")] public string? Tech { get; set; }
    [SupplyParameterFromQuery(Name = "sort")] public string? Sort { get; set; }
    [SupplyParameterFromQuery(Name = "minSalary")] public decimal? MinSalary { get; set; }
    [SupplyParameterFromQuery(Name = "employmentType")] public string? EmploymentType { get; set; }
    [SupplyParameterFromQuery(Name = "location")] public string? Location { get; set; }

    private List<Job> jobs = new();
    private Dictionary<int, string> appliedStatus = new();
    private Dictionary<int, int> counts = new();
    private bool hasProfile, hasCv;

    protected override async Task OnInitializedAsync()
    {
        jobs = Jobs.Filter(Category, Tech, Level, Sort ?? "new", MinSalary, EmploymentType, Location);
        // Chỉ gộp theo những tin đang hiển thị.
        counts = Applications.CountForJobs(jobs.Select(j => j.Id).ToList());

        if (AuthState is null) return;
        var uid = CurrentUser.Id((await AuthState).User);
        if (uid == 0) return;

        var p = Profiles.GetByUserId(uid);
        hasProfile = p != null;
        hasCv = p?.HasCv ?? false;
        // P0-4: Ánh xạ JobId -> Status để phân biệt đã ứng tuyển vs đã rút đơn
        appliedStatus = Applications.AppliedJobStatus(uid);
    }
}
