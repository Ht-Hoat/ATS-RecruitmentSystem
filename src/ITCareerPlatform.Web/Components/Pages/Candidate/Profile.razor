@page "/profile"
@attribute [Authorize(Roles = Roles.Student)]
@inject IProfileService Profiles

@* ATS-08: hồ sơ IT chuyên sâu · ATS-09: tải CV *@

<h1 class="page-title">Hồ sơ IT của tôi</h1>
<p class="sub">Hoàn thiện hồ sơ và tải CV để có thể ứng tuyển việc làm IT.</p>

@if (Saved == "1") { <div class="alert-ok">Đã lưu hồ sơ thành công.</div> }
@if (CvSaved == "1") { <div class="alert-ok">Đã tải CV lên thành công.</div> }
@if (!string.IsNullOrEmpty(CvError)) { <div class="alert-err">@CvError</div> }
@if (!string.IsNullOrEmpty(Error)) { <div class="alert-err">@Error</div> }

<div class="grid2-wide">
    <form method="post" action="/profile/save" class="form" data-vi-validate>
        <AntiforgeryField />
        <h2 class="form-h">1 · Thông tin cá nhân</h2>
        <label>Họ và tên</label>
        <input name="fullName" required minlength="2" value="@p.FullName" />
        <label>Email</label>
        <input name="email" type="email" required value="@p.Email" />
        <div class="grid2">
            <div><label>Số điện thoại</label><input name="phone" value="@p.Phone" /></div>
            <div><label>Ngày sinh</label><input name="dateOfBirth" type="date" value="@(p.DateOfBirth.HasValue ? Ui.InputDate(p.DateOfBirth) : "")" /></div>
        </div>
        <label>Địa chỉ</label>
        <input name="address" value="@p.Address" />

        <h2 class="form-h">2 · Chuyên môn IT</h2>
        <label>Học vấn</label>
        <textarea name="education" rows="2">@p.Education</textarea>
        <label>Kinh nghiệm làm việc</label>
        <textarea name="experience" rows="3">@p.Experience</textarea>
        <label>Số năm kinh nghiệm</label>
        <input name="yearsOfExperience" type="number" min="0" max="50" value="@p.YearsOfExperience" />
        <p class="sub" style="margin-top:4px">
            Nhà tuyển dụng lọc ứng viên theo cấp bậc dựa trên con số này.
            Hiện tại hồ sơ của bạn được xếp: <b>@p.Level</b>
            <span class="sub">(0 năm = Fresher · 1 = Junior · 2-4 = Middle · từ 5 = Senior)</span>
        </p>
        <label>Kỹ năng (mô tả)</label>
        <textarea name="skills" rows="2">@p.Skills</textarea>

        <h2 class="form-h">3 · Hồ sơ chuyên ngành IT</h2>
        <label>GitHub URL</label>
        <input name="githubUrl" value="@p.GithubUrl" placeholder="https://github.com/username" />
        <label>LinkedIn URL</label>
        <input name="linkedInUrl" value="@p.LinkedInUrl" placeholder="https://linkedin.com/in/username" />
        <label>Portfolio / Website</label>
        <input name="portfolioUrl" value="@p.PortfolioUrl" placeholder="https://your-portfolio.dev" />
        <label>Tech Skill Tags (phân cách bằng dấu phẩy)</label>
        <input id="tagInput" name="techSkillTags" value="@p.TechSkillTags" placeholder="C#, React, Docker" oninput="renderChips()" />
        <div id="chipPreview" class="chip-preview"></div>

        <div class="actions">
            <button class="btn-primary" type="submit">Lưu hồ sơ</button>
        </div>
    </form>

    <div class="form">
        <h2 class="form-h">4 · CV của tôi</h2>
        @if (hasCv)
        {
            <div class="cv-current">
                <div class="cv-icon">@(p.CvFileName?.EndsWith(".pdf") == true ? "📄" : "📝")</div>
                <div>
                    <b>@p.CvFileName</b>
                    <div class="sub">Tải lên: @Ui.DateTimeText(p.CvUploadedAt)</div>
                    <a class="btn-sm" href="/profile/cv/download" target="_blank">Xem / Tải lại CV</a>
                </div>
            </div>
            <hr class="sep" />
            <p class="sub">Tải CV mới để thay thế:</p>
        }
        else
        {
            <p class="sub">Bạn chưa tải CV nào lên.</p>
        }
        <form method="post" action="/profile/cv" enctype="multipart/form-data" data-vi-validate>
            <AntiforgeryField />
            <label>Chọn CV (PDF hoặc DOCX, tối đa 5MB)</label>
            <input name="cv" type="file" accept=".pdf,.docx" required />

            @* P2-3: sự đồng ý được LƯU LẠI, không chỉ là một dòng chữ trên màn hình. Thuộc
               tính required chỉ ràng buộc trình duyệt — ProfileService kiểm lại ở tầng dịch vụ. *@
            @if (!p.HasAiConsent)
            {
                <div class="warn-note" style="margin-top:12px">
                    <label style="display:flex;gap:8px;align-items:flex-start;font-weight:normal">
                        <input type="checkbox" name="aiConsent" value="1" required style="margin-top:4px" />
                        <span>
                            Tôi đồng ý cho hệ thống gửi <b>nội dung CV và hồ sơ</b> của tôi tới dịch vụ AI
                            (Google Gemini) để phân tích độ phù hợp với vị trí tuyển dụng và gợi ý lộ trình
                            học tập. Tôi có thể rút lại sự đồng ý này bất cứ lúc nào ở ngay trang Hồ sơ.
                        </span>
                    </label>
                </div>
            }

            <div class="actions">
                <button class="btn-primary" type="submit">Tải CV lên</button>
            </div>
        </form>

        @* P2-3: trạng thái đồng ý và đường rút lại. Đặt ngay cạnh chỗ tải CV vì đó là nơi
           người dùng nghĩ về dữ liệu của mình. *@
        <div style="margin-top:16px;border-top:1px solid #e2e8f0;padding-top:12px">
            <h4 style="margin:0 0 6px 0">🔐 Xử lý dữ liệu cá nhân bằng AI</h4>
            @if (p.HasAiConsent)
            {
                <p class="sub">
                    <span class="ok">● Đã đồng ý</span> lúc @Ui.DateTimeText(p.AiConsentAt)
                    (phiên bản điều khoản @p.AiConsentVersion).
                </p>
                <form method="post" action="/profile/ai-consent/withdraw" class="inline"
                      onsubmit="return confirm('Rút lại đồng ý? Hệ thống sẽ ngừng gửi CV của bạn tới dịch vụ AI. Các kết quả đã chấm trước đó vẫn được giữ lại.');">
                    <AntiforgeryField />
                    <button class="btn-sm ghost" type="submit">Rút lại đồng ý</button>
                </form>
                <p class="sub" style="margin-top:6px">
                    Rút lại nghĩa là hệ thống ngừng gửi CV của bạn đi từ thời điểm đó. Những kết quả
                    đánh giá đã có trước đó vẫn được giữ, vì nhà tuyển dụng đã đọc và đã dựa vào chúng.
                </p>
            }
            else
            {
                <p class="sub">
                    <span class="lock">● Chưa đồng ý</span> — hệ thống sẽ không gửi CV của bạn tới dịch vụ AI.
                    Bạn vẫn ứng tuyển bình thường được, nhưng chức năng đánh giá độ phù hợp sẽ không chạy.
                    Tích ô đồng ý ở khối tải CV bên trên để bật.
                </p>
            }
        </div>
        <p class="sub" style="margin-top:10px">🔒 CV được quét an toàn trước khi lưu (chặn tệp thực thi / mã độc).</p>
    </div>
</div>

<script>
    function renderChips() {
        var v = document.getElementById('tagInput').value || '';
        var box = document.getElementById('chipPreview');
        box.innerHTML = '';
        v.split(',').map(s => s.trim()).filter(s => s).forEach(function (t) {
            var el = document.createElement('span');
            el.className = 'chip'; el.textContent = t;
            box.appendChild(el);
        });
    }
    document.addEventListener('DOMContentLoaded', renderChips);
</script>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }
    [SupplyParameterFromQuery(Name = "cvsaved")] public string? CvSaved { get; set; }
    [SupplyParameterFromQuery(Name = "cverror")] public string? CvError { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }

    private CandidateProfile p = new();
    // Tính trong SQL (GetForEdit) chứ không qua p.HasCv: p là bản chiếu KHÔNG có cột CvData,
    // nên p.HasCv sẽ nói sai "chưa có CV" với hồ sơ cũ chưa di trú sang blob storage.
    private bool hasCv;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;
        var uid = CurrentUser.Id(user);
        if (uid > 0)
        {
            var found = Profiles.GetForEdit(uid);
            hasCv = found?.HasCv ?? false;
            p = found?.Profile ?? new CandidateProfile
            {
                FullName = user.Identity?.Name ?? "",
                Email = user.FindFirstValue(ClaimTypes.Email) ?? ""
            };
        }
    }
}
