@page "/positions/{JobId:int}"
@attribute [Authorize(Roles = Roles.Student)]
@inject IJobService Jobs
@inject IProfileService Profiles
@inject IApplicationService Applications

@* P0-1: Trang chi tiết tin tuyển dụng cho Sinh viên IT *@

<div class="page-head">
    <div>
        <a class="btn ghost" href="/positions" style="margin-bottom: 8px; display: inline-block;">← Quay lại danh sách việc làm</a>
        <h1 class="page-title">@(job?.Title ?? "Chi tiết việc làm")</h1>
    </div>
</div>

@if (!string.IsNullOrEmpty(Msg)) { <div class="alert-ok">@Msg</div> }
@if (!string.IsNullOrEmpty(Err)) { <div class="alert-err">@Err</div> }

@if (status == ViewStatus.NotFound)
{
    <div class="panel">
        <div class="alert-err">Không tìm thấy tin tuyển dụng.</div>
        <p class="sub">Tin tuyển dụng bạn đang tìm kiếm không tồn tại hoặc đã bị xóa.</p>
        <a class="btn-primary" href="/positions">Xem các việc làm khác</a>
    </div>
}
else if (status == ViewStatus.ClosedOrExpired)
{
    <div class="panel">
        <div class="alert-err">Tin tuyển dụng này đã đóng hoặc đã hết hạn nộp hồ sơ.</div>
        <p class="sub">Vị trí <b>@(job?.Title)</b> hiện không còn nhận hồ sơ ứng tuyển mới.</p>
        <a class="btn-primary" href="/positions">Xem các việc làm khác</a>
    </div>
}
else if (job != null)
{
    var daysLeft = (job.Deadline.Date - VietnamDateHelper.Today()).Days;

    <div class="panel" style="margin-bottom: 20px;">
        <div class="job-card-head" style="margin-bottom: 12px;">
            <span class="@Ui.CategoryClass(job.Category)">@job.Category</span>
            <span class="@Ui.LevelClass(job.Level)">@job.Level</span>
            <span class="chip">@job.EmploymentType</span>
        </div>

        <div class="job-meta" style="margin: 16px 0; font-size: 15px; display: flex; flex-wrap: wrap; gap: 16px;">
            <span>📍 <b>Địa điểm:</b> @job.Location</span>
            <span>💰 <b>Mức lương:</b> @Ui.SalaryText(job.SalaryMin, job.SalaryMax)</span>
            <span class="@(daysLeft <= 7 ? "deadline-hot" : "")">
                ⏰ <b>Hạn nộp:</b> @Ui.DateText(job.Deadline)@(daysLeft <= 7 ? $" (còn {daysLeft} ngày)" : "")
            </span>
            <span>👥 <b>Ứng viên:</b> @applicantCount đã nộp</span>
            <span>📅 <b>Ngày đăng:</b> @Ui.DateText(job.CreatedAt)</span>
        </div>

        <div style="margin: 16px 0;">
            <h4 style="margin: 0 0 8px 0;">Tech Stack yêu cầu:</h4>
            <div class="job-tags">
                @foreach (var t in job.TechStackList)
                {
                    <span class="chip">@t</span>
                }
            </div>
        </div>

        <div class="job-card-foot" style="margin-top: 20px; border-top: 1px solid #e2e8f0; padding-top: 16px;">
            @if (appliedStatus.TryGetValue(job.Id, out var aStatus))
            {
                if (aStatus == ApplicationStatus.Withdrawn)
                {
                    <span class="muted" style="font-weight: 500;">🛑 Bạn đã rút đơn khỏi vị trí này</span>
                }
                else
                {
                    <span class="ok" style="font-weight: bold; font-size: 16px;">✔ Đã ứng tuyển (Trạng thái: @aStatus)</span>
                    <a class="btn-sm ghost" href="/my-applications" style="margin-left: 12px;">Xem đơn của tôi</a>
                }
            }
            else if (!hasProfile || !hasCv)
            {
                <a class="btn ghost" href="/profile">Hoàn thiện hồ sơ & CV để ứng tuyển</a>
            }
            else
            {
                <form method="post" action="@($"/jobs/{job.Id}/apply")" class="inline" onsubmit="return confirm('Bạn chắc chắn muốn ứng tuyển vị trí này? CV hiện tại sẽ được gắn vào đơn.');">
                    <input type="hidden" name="from" value="detail" />
                    <button class="btn-primary" type="submit" style="font-size: 16px; padding: 8px 24px;">Ứng tuyển ngay</button>
                </form>
            }
        </div>
    </div>

    <div class="panel" style="margin-bottom: 20px;">
        <h2>Mô tả công việc (JD)</h2>
        <div style="white-space: pre-wrap; line-height: 1.6; color: #334155;">@job.Description</div>
    </div>

    <div class="panel" style="margin-bottom: 20px;">
        <h2>Yêu cầu ứng viên</h2>
        <div style="white-space: pre-wrap; line-height: 1.6; color: #334155;">@job.Requirements</div>
    </div>
}

@code {
    [Parameter] public int JobId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Msg { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }

    private enum ViewStatus { Loading, Active, NotFound, ClosedOrExpired }
    private ViewStatus status = ViewStatus.Loading;

    private Job? job;
    private Dictionary<int, string> appliedStatus = new();
    private int applicantCount;
    private bool hasProfile, hasCv;

    protected override async Task OnInitializedAsync()
    {
        job = Jobs.GetById(JobId);
        if (job is null)
        {
            status = ViewStatus.NotFound;
            return;
        }

        var visible = Jobs.GetVisibleForCandidate(JobId);
        if (visible is null)
        {
            status = ViewStatus.ClosedOrExpired;
            return;
        }

        status = ViewStatus.Active;
        var counts = Applications.CountForJobs(new[] { JobId });
        applicantCount = counts.GetValueOrDefault(JobId);

        if (AuthState is null) return;
        var uid = CurrentUser.Id((await AuthState).User);
        if (uid > 0)
        {
            var p = Profiles.GetByUserId(uid);
            hasProfile = p != null;
            hasCv = p?.HasCv ?? false;
            appliedStatus = Applications.AppliedJobStatus(uid);
        }
    }
}
