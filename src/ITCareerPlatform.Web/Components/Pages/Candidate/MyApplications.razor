@page "/my-applications"
@attribute [Authorize(Roles = Roles.Student)]
@inject IApplicationService Applications

<h1 class="page-title">Đơn ứng tuyển của tôi</h1>
<p class="sub">Bạn đã nộp <b>@apps.Count</b> đơn. Bấm "Chi tiết" để đọc <b>đánh giá độ phù hợp & lộ trình gợi ý</b> cho từng vị trí.</p>

@if (!string.IsNullOrEmpty(Msg)) { <div class="alert-ok">@Msg</div> }
@if (!string.IsNullOrEmpty(Err)) { <div class="alert-err">@Err</div> }

<table class="tbl">
    <thead>
        <tr><th>ID</th><th>Vị trí</th><th>Danh mục</th><th>Cấp bậc</th><th>% phù hợp</th><th>Ngày nộp</th><th>Trạng thái</th><th>Thao tác</th></tr>
    </thead>
    <tbody>
        @foreach (var a in apps)
        {
            <tr>
                <td>@a.Id</td>
                <td>@a.JobTitle</td>
                <td><span class="@Ui.CategoryClass(a.Category)">@a.Category</span></td>
                <td><span class="@Ui.LevelClass(a.Level)">@a.Level</span></td>
                <td>
                    @if (a.AiScore.HasValue)
                    {
                        <span class="@Ui.ScoreClass(a.AiScore)">@a.AiScore%</span>
                        @if (a.AiSource == EvaluationSource.Offline) { <span class="sub" title="Tính bằng công thức đối chiếu ngoại tuyến, không phải mô hình AI">📴</span> }
                    }
                    else { <span class="sub">Chưa có</span> }
                </td>
                <td>@Ui.DateTimeText(a.AppliedAt)</td>
                <td>
                    <span class="@Ui.StatusClass(a.Status)">@a.Status</span>
                    @* N1.E: giờ hẹn hiện ngay ở danh sách — sinh viên không phải mở từng đơn
                       để biết mình có lịch phỏng vấn nào sắp tới. *@
                    @if (a.HasInterview)
                    {
                        <br />
                        <span class="sub" style="font-size:12px">📅 @Ui.DateTimeText(a.InterviewAt)</span>
                    }
                </td>
                <td>
                    <div class="row-actions">
                        <a class="btn-sm" href="@($"/my-applications/{a.Id}")">Chi tiết</a>
                        @if (a.Status != ApplicationStatus.Accepted && a.Status != ApplicationStatus.Rejected && a.Status != ApplicationStatus.Withdrawn)
                        {
                            <form method="post" action="@($"/applications/{a.Id}/withdraw")" onsubmit="return confirm('Bạn chắc chắn muốn rút đơn ứng tuyển này? Hành động này không thể hoàn tác.');">
                                <AntiforgeryField />
                                <button class="btn-sm danger-outline" type="submit" title="Rút đơn ứng tuyển">Rút đơn</button>
                            </form>
                        }
                    </div>
                </td>
            </tr>
        }
        @if (apps.Count == 0)
        {
            <tr><td colspan="8" class="sub">Bạn chưa ứng tuyển vị trí nào. <a href="/positions">Xem việc làm IT</a>.</td></tr>
        }
    </tbody>
</table>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "msg")] public string? Msg { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }
    private List<MyApplicationItem> apps = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var uid = CurrentUser.Id((await AuthState).User);
        if (uid > 0) apps = Applications.GetByCandidate(uid);
    }
}
