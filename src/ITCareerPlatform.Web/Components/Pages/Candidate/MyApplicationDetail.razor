@page "/my-applications/{AppId:int}"
@attribute [Authorize(Roles = Roles.Student)]
@inject IApplicationService Applications

@* Sinh viên xem chi tiết đơn của MÌNH + đánh giá độ phù hợp & lộ trình (ATS-14) *@

@if (app is null || !isOwner)
{
    <div class="page-head">
        <h1 class="page-title">Không tìm thấy đơn</h1>
        <a class="btn" href="/my-applications">← Về danh sách đơn</a>
    </div>
    <p class="sub">Đơn ứng tuyển không tồn tại hoặc không thuộc về bạn.</p>
}
else
{
    <div class="page-head">
        <h1 class="page-title">Chi tiết đơn ứng tuyển</h1>
        <a class="btn" href="/my-applications">← Về danh sách đơn</a>
    </div>

    <div class="panel">
        <h2>Vị trí ứng tuyển</h2>
        <p class="sub">
            <b>@app.JobTitle</b>
            <span class="@Ui.CategoryClass(app.JobCategory)">@app.JobCategory</span>
            <span class="@Ui.LevelClass(app.JobLevel)">@app.JobLevel</span>
            · Ngày nộp: @Ui.DateTimeText(app.AppliedAt)
            · Trạng thái: <span class="@Ui.StatusClass(app.Status)">@app.Status</span>
        </p>
        <p class="sub">Yêu cầu Tech Stack của vị trí: <b>@app.JobTechStack</b></p>

        @if (app.Status != ApplicationStatus.Accepted && app.Status != ApplicationStatus.Rejected && app.Status != ApplicationStatus.Withdrawn)
        {
            <div style="margin-top: 16px; border-top: 1px solid #e2e8f0; padding-top: 12px;">
                <form method="post" action="@($"/applications/{app.Id}/withdraw")" class="inline" onsubmit="return confirm('Bạn chắc chắn muốn rút đơn ứng tuyển này? Hành động này không thể hoàn tác.');">
                    <button class="btn danger" type="submit">🛑 Rút đơn ứng tuyển</button>
                </form>
            </div>
        }
    </div>

    @* P1-4: phản hồi của nhà tuyển dụng. Đây là trường DUY NHẤT trong nhóm ghi chú được
       hiện cho ứng viên — HrNote (lý do chốt điểm) và InternalNote (nhận định riêng của
       Mentor) vẫn nằm ngoài record này. *@
    @if (!string.IsNullOrWhiteSpace(app.CandidateFeedback))
    {
        <div class="panel" style="margin-top:16px;border-left:4px solid #6366f1">
            <h2>💬 Phản hồi từ nhà tuyển dụng</h2>
            <div style="white-space: pre-wrap; line-height: 1.6; color: #334155;">@app.CandidateFeedback</div>
        </div>
    }

    @* N1.E: lịch phỏng vấn hiện ngay trên đơn, không có trang "Lịch phỏng vấn" riêng. *@
    @if (app.HasInterview)
    {
        <div class="panel" style="margin-top:16px;border-left:4px solid #f97316">
            <h2>📅 Lịch phỏng vấn</h2>
            <table class="tbl-info">
                <tr><td class="k">Thời gian</td><td><b>@Ui.DateTimeText(app.InterviewAt)</b></td></tr>
                @if (!string.IsNullOrWhiteSpace(app.InterviewLink))
                {
                    @* rel="noopener noreferrer" cho link ra ngoài; địa chỉ đã được service
                       kiểm tra chỉ nhận http/https trước khi lưu. *@
                    <tr>
                        <td class="k">Link tham gia</td>
                        <td><a href="@app.InterviewLink" target="_blank" rel="noopener noreferrer">@app.InterviewLink</a></td>
                    </tr>
                }
                else
                {
                    <tr><td class="k">Hình thức</td><td>Phỏng vấn trực tiếp — vui lòng liên hệ nhà tuyển dụng để biết địa điểm.</td></tr>
                }
                @if (!string.IsNullOrWhiteSpace(app.InterviewNote))
                {
                    <tr><td class="k">Ghi chú</td><td>@app.InterviewNote</td></tr>
                }
            </table>
        </div>
    }

    <div class="panel" style="margin-top:16px">
        <h2>🧭 Đánh giá độ phù hợp & Gợi ý lộ trình cho bạn</h2>
        <AiEvaluationCard Eval="app.Ai" ForStudent="true" />
        @if (!app.HasAiEvaluation)
        {
            <p class="sub">Nhà tuyển dụng chưa chạy đánh giá cho đơn này. Hãy hoàn thiện hồ sơ & CV để có kết quả tốt nhất.</p>
        }
    </div>
}

@code {
    [Parameter] public int AppId { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    private ApplicationDetail? app;
    private bool isOwner;

    protected override async Task OnInitializedAsync()
    {
        // Bản chiếu, không kèm byte[] CV — trang này không hiển thị nội dung CV.
        app = Applications.GetDetail(AppId);
        if (app is null || AuthState is null) return;

        var uid = CurrentUser.Id((await AuthState).User);
        isOwner = uid > 0 && app.CandidateUserId == uid;
    }
}
