@page "/change-password"
@attribute [Authorize]

@* N1.A: đổi mật khẩu — dùng chung cho cả ba vai trò, nên trang nằm ở Pages/Account
   chứ không phải Pages/Users (khu vực đó chỉ Admin vào được). *@

<div class="page-head">
    <h1 class="page-title">Đổi mật khẩu</h1>
    <a class="btn" href="/">← Về trang chủ</a>
</div>

@if (!string.IsNullOrEmpty(Error)) { <div class="alert-err">@Error</div> }
@if (Forced == "1")
{
    <div class="alert-err" style="background: #fef2f2; border-left: 4px solid #ef4444; padding: 12px 16px; margin-bottom: 16px; border-radius: 4px;">
        ⚠️ <b>Yêu cầu đổi mật khẩu:</b> Mật khẩu của bạn vừa được đặt lại hoặc tài khoản yêu cầu cập nhật mật khẩu mới trước khi tiếp tục sử dụng hệ thống.
    </div>
}

<form method="post" action="/account/change-password" class="form">
    <label>Mật khẩu hiện tại</label>
    <input name="currentPassword" type="password" autocomplete="current-password" required />

    <label>Mật khẩu mới</label>
    <input name="newPassword" type="password" autocomplete="new-password" minlength="8" maxlength="100" required />

    <label>Nhập lại mật khẩu mới</label>
    <input name="confirmPassword" type="password" autocomplete="new-password" minlength="8" maxlength="100" required />

    @* minlength trong form chỉ là gợi ý cho trình duyệt; luật thật nằm ở UserService. *@
    <p class="sub" style="margin-top:10px">Tối thiểu 8 ký tự, và phải khác mật khẩu hiện tại.</p>

    <div class="actions">
        <button class="btn-primary" type="submit">Đổi mật khẩu</button>
        <a class="btn" href="/">Hủy</a>
    </div>
</form>

<div class="hint" style="max-width:640px">
    ⚠️ Sau khi đổi mật khẩu, <b>mọi phiên đăng nhập của tài khoản này sẽ bị đăng xuất</b>,
    kể cả phiên đang mở trên máy khác. Bạn cần đăng nhập lại bằng mật khẩu mới.
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "forced")] public string? Forced { get; set; }
}
