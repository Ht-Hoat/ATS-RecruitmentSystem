@page "/users/new"
@attribute [Authorize(Roles = Roles.Admin)]
@inject IUserService Users

<h1 class="page-title">Tạo tài khoản mới (ATS-01)</h1>
@if (!string.IsNullOrEmpty(Error)) { <div class="alert-err">@Error</div> }

<form method="post" action="/users/create" class="form" data-vi-validate>
    <AntiforgeryToken />
    <label>Họ tên</label>
    <input name="fullName" required maxlength="120" placeholder="Nguyễn Văn A" />
    <label>Email</label>
    <input name="email" type="email" required maxlength="160" placeholder="a@itcp.vn" />
    <label>Mật khẩu (tối thiểu 8 ký tự)</label>
    @* Không còn điền sẵn "123456": đường tạo tài khoản của Admin nay áp dụng đúng
       bộ luật mật khẩu như đường sinh viên tự đăng ký. *@
    <input name="password" type="password" required minlength="8" placeholder="••••••••" />
    <label>Vai trò</label>
    <select name="roleId" required>
        @foreach (var r in roleList) { <option value="@r.Id">@Roles.Display(r.RoleName)</option> }
    </select>
    <div class="actions">
        <button class="btn-primary" type="submit">Lưu tài khoản</button>
        <a class="btn" href="/users">Hủy</a>
    </div>
</form>

@code {
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private List<Role> roleList = new();
    protected override void OnInitialized() => roleList = Users.GetRoles();
}
