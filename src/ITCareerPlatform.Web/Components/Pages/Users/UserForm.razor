@page "/users/new"
@attribute [Authorize(Roles = "Admin")]
@inject AppDbContext Db

<h1 class="page-title">Tạo tài khoản mới</h1>

<form method="post" action="/users/create" class="form" data-vi-validate>
    <label>Họ tên</label>
    <input name="fullName" required minlength="2" placeholder="Nguyễn Văn A" />
    <label>Email</label>
    <input name="email" type="email" required placeholder="a@itcp.vn" />
    <label>Mật khẩu</label>
    <input name="password" type="password" required minlength="6" value="123456" />
    <label>Vai trò</label>
    <select name="roleId" required>
        @foreach (var r in roleList) { <option value="@r.Id">@Roles.Display(r.RoleName)</option> }
    </select>
    <div class="actions">
        <button class="btn-primary" type="submit">Lưu tài khoản</button>
        <a class="btn" href="/users">Hủy</a>
    </div>
</form>

@code {
    private List<Role> roleList = new();
    protected override void OnInitialized() => roleList = Db.Roles.ToList();
}
