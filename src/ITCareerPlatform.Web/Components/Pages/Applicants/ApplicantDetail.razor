@page "/applications/{AppId:int}"
@attribute [Authorize(Roles = Roles.AdminOrMentor)]
@inject IApplicationService Applications
@inject IUserService Users

@* ATS-12: chi tiết hồ sơ IT + CV · ATS-13/14: AI · ATS-16: điều chỉnh · ATS-17: trạng thái *@

@if (!canAccess)
{
    <div class="alert-err">Bạn không có quyền xem đơn này — chỉ Mentor tạo tin hoặc Admin mới được xem.</div>
    <a class="btn" href="/jobs">← Về danh sách tin</a>
}
else if (app is null)
{
    <p class="sub">Không tìm thấy đơn ứng tuyển.</p>
}
else
{
    <div class="page-head">
        <h1 class="page-title">Hồ sơ ứng viên</h1>
        <a class="btn" href="@($"/jobs/{app.JobId}/applicants")">← Về danh sách ứng viên</a>
    </div>

    @if (AiScored == "1") { <div class="alert-ok">Đã đánh giá độ phù hợp & tạo gợi ý lộ trình.</div> }
    @if (!string.IsNullOrEmpty(AiError)) { <div class="alert-err">Lỗi AI: @AiError</div> }
    @if (!string.IsNullOrEmpty(StatusMsg)) { <div class="alert-ok">@StatusMsg</div> }
    @if (!string.IsNullOrEmpty(StatusErr)) { <div class="alert-err">@StatusErr</div> }
    @if (!canModify)
    {
        <div class="warn-note">👁 Chế độ chỉ xem — đánh giá và quyết định tuyển dụng do Mentor đăng tin thực hiện.</div>
    }

    <!-- Section 1: thông tin ứng tuyển -->
    <div class="panel">
        <h2>1 · Thông tin ứng tuyển</h2>
        <p class="sub">
            Vị trí: <b>@app.JobTitle</b>
            <span class="@Ui.CategoryClass(app.JobCategory)">@app.JobCategory</span>
            <span class="@Ui.LevelClass(app.JobLevel)">@app.JobLevel</span>
            · Ngày nộp: @Ui.DateTimeText(app.AppliedAt)
            · Trạng thái: <span class="@Ui.StatusClass(app.Status)">@app.Status</span>
        </p>
    </div>

    <!-- Section 2 + 3: hồ sơ IT -->
    <div class="grid2-wide" style="margin-top:16px">
        <div class="panel">
            <h2>2 · Thông tin cá nhân</h2>
            <table class="tbl-info">
                <tr><td class="k">Họ và tên</td><td>@app.FullName</td></tr>
                <tr><td class="k">Email</td><td>@app.Email</td></tr>
                <tr><td class="k">Số điện thoại</td><td>@app.Phone</td></tr>
                <tr><td class="k">Ngày sinh</td><td>@Ui.DateText(app.DateOfBirth)</td></tr>
                <tr><td class="k">Địa chỉ</td><td>@app.Address</td></tr>
                <tr><td class="k">Học vấn</td><td>@app.Education</td></tr>
                <tr><td class="k">Kinh nghiệm</td><td>@app.Experience</td></tr>
            </table>
        </div>

        <div class="panel">
            <h2>3 · Hồ sơ chuyên ngành IT</h2>
            <div class="it-links">
                @if (!string.IsNullOrWhiteSpace(app.GithubUrl)) { <a href="@app.GithubUrl" target="_blank" rel="noopener noreferrer" class="it-link">🐙 GitHub</a> }
                @if (!string.IsNullOrWhiteSpace(app.LinkedInUrl)) { <a href="@app.LinkedInUrl" target="_blank" rel="noopener noreferrer" class="it-link">💼 LinkedIn</a> }
                @if (!string.IsNullOrWhiteSpace(app.PortfolioUrl)) { <a href="@app.PortfolioUrl" target="_blank" rel="noopener noreferrer" class="it-link">🌐 Portfolio</a> }
            </div>
            <p class="k" style="margin-top:14px">Tech Skill Tags</p>
            <div class="chip-preview">
                @foreach (var t in app.SkillTagList) { <span class="chip">@t</span> }
                @if (app.SkillTagList.Count == 0) { <span class="sub">Chưa khai báo.</span> }
            </div>
            <p class="k" style="margin-top:14px">Kỹ năng (mô tả)</p>
            <p>@app.Skills</p>
        </div>
    </div>

    <!-- Section 4: CV + AI -->
    <div class="panel" style="margin-top:16px">
        <h2>4 · CV & Đánh giá độ phù hợp (AI)</h2>
        @if (app.HasCv)
        {
            <p>📎 CV đã nộp: <b>@app.CvFileNameSnapshot</b>
               <span class="sub">(bản chụp tại thời điểm nộp @Ui.DateTimeText(app.AppliedAt) — không đổi khi ứng viên cập nhật CV sau này)</span>
               &nbsp; <a class="btn-sm" href="@($"/applications/{app.Id}/cv")" target="_blank">Tải CV (PDF/DOCX)</a></p>
        }
        else { <p class="sub">Ứng viên chưa tải CV lên.</p> }

        <hr class="sep" />

        <div class="ai-box">
            @if (!app.HasAiEvaluation)
            {
                <div class="ai-placeholder">
                    <p class="sub">Chưa có đánh giá độ phù hợp cho ứng viên này.</p>
                    @if (canModify)
                    {
                        <form method="post" action="@($"/applications/{app.Id}/ai-evaluate")">
                            <AntiforgeryField />
                            <button class="btn-ai" type="submit">🧭 Đánh giá độ phù hợp & Gợi ý lộ trình</button>
                        </form>
                        <p class="sub" style="margin-top:8px">🔐 Khi chạy đánh giá, nội dung CV của ứng viên có thể được gửi tới dịch vụ AI (Google Gemini) để phân tích.</p>
                    }
                </div>
            }
            else
            {
                <AiEvaluationCard Eval="app.Ai" ForStudent="false" />
                @if (canModify)
                {
                    <form method="post" action="@($"/applications/{app.Id}/ai-evaluate")" class="inline">
                        <AntiforgeryField />
                        <button class="btn-sm ghost" type="submit">🔄 Đánh giá lại</button>
                    </form>
                }

                @* Không còn khối "đồng ý với AI / chốt %": con số chốt tay không dẫn tới hành động
                   nào. Quyết định thật của nhà tuyển dụng — mời phỏng vấn hay từ chối — nằm ở mục 5;
                   điểm AI ở trên chỉ để tham khảo và xếp hạng trong danh sách ứng viên. *@
            }
        </div>
    </div>

    <!-- Section 5: quyết định tuyển dụng + dòng thời gian -->
    <div class="panel" style="margin-top:16px">
        <h2>5 · Quyết định tuyển dụng</h2>
        @* Mỗi quyết định là một thẻ riêng với đúng những ô nó cần, thay cho một ô chọn trạng thái
           chung. Mọi thẻ gửi về cùng /applications/{id}/status; luồng hợp lệ vẫn do
           ApplicationStatusFlow ở service phát biểu, và sinh viên nhận thông báo + email như cũ. *@
        @if (nextStates.Count == 0)
        {
            @* P1-4: đơn ở trạng thái kết thúc — nói thẳng thay vì hiện form rồi từ chối khi lưu. *@
            <div class="warn-note">
                Đơn đã ở trạng thái <b>@app.Status</b> — đây là trạng thái kết thúc, không đổi tiếp được.
                @if (app.Status == ApplicationStatus.Withdrawn)
                {
                    <text> Chính ứng viên đã rút đơn này.</text>
                }
            </div>
        }
        else if (!canModify)
        {
            <p class="sub">Trạng thái hiện tại: <span class="@Ui.StatusClass(app.Status)">@app.Status</span></p>
        }
        else
        {
            <p class="sub">Trạng thái hiện tại: <span class="@Ui.StatusClass(app.Status)">@app.Status</span>
                — ứng viên nhận thông báo và email ngay khi bạn chọn.</p>

            @if (nextStates.Contains(ApplicationStatus.Reviewing))
            {
                <form method="post" action="@($"/applications/{app.Id}/status")" style="margin-bottom:12px">
                    <AntiforgeryField />
                    <input type="hidden" name="status" value="@ApplicationStatus.Reviewing" />
                    <button class="btn-sm ghost" type="submit">👀 Đánh dấu "Đang xem xét"</button>
                    <span class="sub" style="margin-left:8px">Để các Mentor khác biết hồ sơ đã có người đọc.</span>
                </form>
            }

            <div class="decision-grid">
                @if (nextStates.Contains(ApplicationStatus.Interview))
                {
                    var rescheduling = app.Status == ApplicationStatus.Interview;
                    <form method="post" action="@($"/applications/{app.Id}/status")" class="decision-card decision-go"
                          onsubmit="return confirm('@(rescheduling ? "Gửi lịch phỏng vấn mới cho ứng viên?" : "Mời ứng viên này phỏng vấn?")');">
                        <AntiforgeryField />
                        <input type="hidden" name="status" value="@ApplicationStatus.Interview" />
                        <h3>@(rescheduling ? "📅 Đổi lịch phỏng vấn" : "✅ Mời phỏng vấn")</h3>
                        <p class="sub">CV phù hợp? Hẹn lịch — ứng viên nhận lời mời kèm tệp lịch .ics.</p>
                        <label>Thời gian</label>
                        <input name="interviewAt" type="datetime-local" required value="@Ui.InputDateTimeLocal(app.InterviewAt)" />
                        <label>Link họp (Google Meet / Zoom / Teams)</label>
                        <input name="interviewLink" type="url" maxlength="400" placeholder="Để trống nếu phỏng vấn trực tiếp"
                               value="@app.InterviewLink" />
                        <label>Ghi chú cho ứng viên</label>
                        <textarea name="interviewNote" rows="2" maxlength="500"
                                  placeholder="Vòng 1 — phỏng vấn kỹ thuật, khoảng 45 phút...">@app.InterviewNote</textarea>
                        <button class="btn-sm" type="submit">@(rescheduling ? "Gửi lịch mới" : "Gửi lời mời phỏng vấn")</button>
                    </form>
                }

                @if (nextStates.Contains(ApplicationStatus.Accepted))
                {
                    <form method="post" action="@($"/applications/{app.Id}/status")" class="decision-card decision-win"
                          onsubmit="return confirm('Xác nhận nhận ứng viên này? Đây là quyết định cuối, không đổi lại được.');">
                        <AntiforgeryField />
                        <input type="hidden" name="status" value="@ApplicationStatus.Accepted" />
                        <h3>🏆 Nhận vào làm</h3>
                        <p class="sub">Sau buổi phỏng vấn: ứng viên nhận thông báo và email chúc mừng.</p>
                        <button class="btn-sm success" type="submit">Xác nhận trúng tuyển</button>
                    </form>
                }

                @if (nextStates.Contains(ApplicationStatus.Rejected))
                {
                    <form method="post" action="@($"/applications/{app.Id}/status")" class="decision-card decision-stop"
                          onsubmit="return confirm('Từ chối hồ sơ này? Đây là quyết định cuối, không đổi lại được.');">
                        <AntiforgeryField />
                        <input type="hidden" name="status" value="@ApplicationStatus.Rejected" />
                        <h3>❌ Từ chối</h3>
                        <p class="sub">Ứng viên ĐỌC ĐƯỢC phản hồi này — viết để họ biết cần cải thiện gì.</p>
                        <label>Phản hồi gửi ứng viên (tùy chọn)</label>
                        <textarea name="candidateFeedback" rows="4" maxlength="1000"
                                  placeholder="Hồ sơ tốt nhưng chưa đủ kinh nghiệm với Docker/Kubernetes ở vị trí này...">@app.CandidateFeedback</textarea>
                        <button class="btn-sm danger-outline" type="submit">Gửi từ chối</button>
                    </form>
                }
            </div>
        }

        @if (app.HasInterview)
        {
            <div class="warn-note" style="margin-top:12px">
                📅 Lịch phỏng vấn hiện tại: <b>@Ui.DateTimeText(app.InterviewAt)</b>
                @if (!string.IsNullOrWhiteSpace(app.InterviewLink))
                {
                    <text> · </text><a href="@app.InterviewLink" target="_blank" rel="noopener noreferrer">Link tham gia</a>
                }
                @if (!string.IsNullOrWhiteSpace(app.InterviewNote))
                {
                    <br />
                    <span class="sub">@app.InterviewNote</span>
                }
            </div>
        }


        <div class="timeline">
            <div class="tl-item">
                <span class="tl-dot @Ui.StatusClass(ApplicationStatus.Submitted)"></span>
                <div><b>Nộp đơn</b> — @app.FullName — @Ui.DateTimeText(app.AppliedAt)</div>
            </div>
            @foreach (var h in history)
            {
                <div class="tl-item">
                    <span class="tl-dot @Ui.StatusClass(h.ToStatus)"></span>
                    <div>@h.FromStatus → <b>@h.ToStatus</b> — @(names.GetValueOrDefault(h.ChangedByUserId, "#" + h.ChangedByUserId)) — @Ui.DateTimeText(h.ChangedAt)</div>
                </div>
            }
        </div>
    </div>


}

@code {
    [Parameter] public int AppId { get; set; }
    [SupplyParameterFromQuery(Name = "aiscored")] public string? AiScored { get; set; }
    [SupplyParameterFromQuery(Name = "aierror")] public string? AiError { get; set; }
    [SupplyParameterFromQuery(Name = "statusmsg")] public string? StatusMsg { get; set; }
    [SupplyParameterFromQuery(Name = "statuserr")] public string? StatusErr { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private ApplicationDetail? app;
    private List<ApplicationStatusHistory> history = new();
    private Dictionary<int, string> names = new();
    private bool canAccess;   // xem: Mentor chủ tin hoặc Admin
    private bool canModify;   // thao tác: chỉ Mentor chủ tin
    /// <summary>P1-4: các bước tiếp theo hợp lệ; rỗng nghĩa là đơn đã chốt.</summary>
    private IReadOnlyList<string> nextStates = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;
        var user = (await AuthState).User;

        // Hai luật hỏi qua service — cùng những hàm mà các endpoint dùng, thay vì viết lại
        // vị ngữ trong @code và để nó lệch dần khỏi bản của server.
        // XEM: chủ tin hoặc Admin. THAO TÁC: chỉ Mentor chủ tin — Admin chỉ giám sát.
        canAccess = Applications.CanAccess(AppId, CurrentUser.Id(user), CurrentUser.IsAdmin(user));
        if (!canAccess) return;
        canModify = Applications.CanModify(AppId, CurrentUser.Id(user));

        // Bản chiếu: không kéo về hai cột byte[] (mỗi cột tới 5MB) mà trang này không hiển thị.
        app = Applications.GetDetail(AppId);
        if (app is null) return;

        nextStates = ApplicationStatusFlow.NextStates(app.Status);

        history = Applications.GetStatusHistory(AppId);

        // Chỉ hỏi tên của những người xuất hiện trong dòng thời gian (nhiều nhất vài người),
        // thay vì nạp toàn bộ bảng Users.
        names = Users.GetNames(history.Select(h => h.ChangedByUserId));
    }
}
