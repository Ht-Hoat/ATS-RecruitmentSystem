@page "/audit"
@attribute [Authorize(Roles = "Admin")]
@inject AppDbContext Db

<h1 class="page-title">Nhật ký hệ thống (AuditLog)</h1>
<p class="sub">Ghi lại các thao tác quan trọng, ví dụ đổi vai trò người dùng.</p>

<table class="tbl">
    <thead><tr><th>ID</th><th>Người thực hiện</th><th>Hành động</th><th>Bảng</th><th>Chi tiết</th><th>Thời điểm</th></tr></thead>
    <tbody>
        @foreach (var a in logs)
        {
            <tr>
                <td>@a.Id</td>
                <td>@(userNames.TryGetValue(a.UserId, out var n) ? n : ("#" + a.UserId))</td>
                <td><span class="tag">@a.Action</span></td>
                <td>@a.TableName</td>
                <td>@a.Details</td>
                <td>@a.Timestamp.ToString("dd/MM/yyyy HH:mm")</td>
            </tr>
        }
        @if (logs.Count == 0) { <tr><td colspan="6" class="sub">Chưa có nhật ký.</td></tr> }
    </tbody>
</table>

@code {
    private List<AuditLog> logs = new();
    private Dictionary<int, string> userNames = new();

    protected override void OnInitialized()
    {
        logs = Db.AuditLogs.OrderByDescending(x => x.Id).ToList();
        userNames = Db.Users.ToDictionary(u => u.Id, u => u.FullName);
    }
}
