@page "/jobs/edit/{JobId:int}"
@* Chỉ Mentor đăng/sửa tin — Admin chỉ xem danh sách. *@
@attribute [Authorize(Roles = Roles.Mentor)]
@inject IJobService Jobs
@inject ICompanyService Companies

@* Sửa tin việc IT *@

@if (model is null)
{
    <p class="sub">Không tìm thấy tin tuyển dụng.</p>
}
else
{
    <h1 class="page-title">Sửa tin tuyển dụng IT</h1>
    @if (!string.IsNullOrEmpty(Error)) { <div class="alert-err">@Error</div> }
    @if (model.Status == JobStatus.Closed)
    {
        <div class="alert-err">Tin đang ở trạng thái <b>Đã đóng</b>. Vui lòng mở lại tin trước khi sửa.</div>
    }

    <form method="post" action="@($"/jobs/{model.Id}/update")" class="form form-wide" data-vi-validate>
        <AntiforgeryToken />
        <JobFields Model="model" CompanyName="@companyName" />
        <div class="actions">
            <button class="btn-primary" type="submit" disabled="@(model.Status == JobStatus.Closed)">Lưu thay đổi</button>
            <a class="btn" href="/jobs">Hủy</a>
        </div>
    </form>
}

@code {
    [Parameter] public int JobId { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    private Job? model;
    private string? companyName;

    protected override void OnInitialized()
    {
        model = Jobs.GetById(JobId);
        // Công ty của TIN, không phải của người đang sửa: Admin sửa tin của Mentor khác thì
        // dải chỉ-đọc phải nói đúng công ty mà tin đang đứng tên.
        if (model is not null) companyName = Companies.GetById(model.CompanyId)?.Name;
    }
}
