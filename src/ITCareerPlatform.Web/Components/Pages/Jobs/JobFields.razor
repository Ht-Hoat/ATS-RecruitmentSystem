@* Các trường nhập của tin việc IT — dùng chung cho Tạo và Sửa *@

<label>Tiêu đề công việc</label>
<input name="title" required minlength="5" maxlength="160" value="@Model.Title" placeholder="Lập trình viên Backend .NET" />

<label>Mô tả công việc (JD)</label>
<textarea name="description" rows="3" required minlength="20" maxlength="4000" placeholder="Mô tả chi tiết...">@Model.Description</textarea>

<label>Yêu cầu ứng viên</label>
<textarea name="requirements" rows="2" required minlength="10" maxlength="4000" placeholder="Kỹ năng, kinh nghiệm...">@Model.Requirements</textarea>

<div class="grid3">
    <div>
        <label>Danh mục (Category)</label>
        <select name="category" required>
            @* Blazor bỏ hẳn thuộc tính boolean khi giá trị là false, nên không cần if/else. *@
            @foreach (var c in Job.Categories)
            {
                <option value="@c" selected="@(c == Model.Category)">@c</option>
            }
        </select>
    </div>
    <div>
        <label>Cấp bậc (Level)</label>
        <select name="level" required>
            @foreach (var l in Job.Levels)
            {
                <option value="@l" selected="@(l == Model.Level)">@l</option>
            }
        </select>
    </div>
    <div>
        <label>Hình thức làm việc</label>
        <select name="employmentType" required>
            @foreach (var et in Job.EmploymentTypes)
            {
                <option value="@et" selected="@(et == Model.EmploymentType)">@et</option>
            }
        </select>
    </div>
</div>

<div class="grid2" style="margin-top:10px">
    <div>
        <label>Địa điểm</label>
        <input name="location" required minlength="2" maxlength="120" value="@Model.Location" placeholder="Hà Nội" />
    </div>
    <div>
        <label>Tech Stack (phân cách bằng dấu phẩy)</label>
        <input name="techStack" required minlength="2" maxlength="400" value="@Model.TechStack" placeholder="C#, .NET, SQL Server, Docker" />
    </div>
</div>

@* Giá trị số và ngày phải theo chuẩn HTML, không theo culture máy chủ: với vi-VN,
   decimal 15.50 render thành "15,50" — trình duyệt coi là không hợp lệ và bỏ trắng ô,
   nên chỉ cần sửa tiêu đề rồi lưu là cả hai mức lương bị ghi về 0. *@
<div class="grid3" style="margin-top:10px">
    <div><label>Lương tối thiểu (triệu)</label><input name="salaryMin" type="number" step="0.1" min="0" max="999" value="@Ui.InputNumber(Model.SalaryMin)" /></div>
    <div><label>Lương tối đa (triệu)</label><input name="salaryMax" type="number" step="0.1" min="0" max="999" value="@Ui.InputNumber(Model.SalaryMax)" /></div>
    <div><label>Hạn nộp</label><input name="deadline" type="date" required value="@DeadlineValue" /></div>
</div>

@code {
    [Parameter] public Job Model { get; set; } = new();

    @* P0-2: hạn nộp mặc định tính theo lịch VIỆT NAM. DateTime.Today là ngày của máy chủ,
       nên trên container chạy UTC thì ô này gợi ý sai một ngày suốt khung 00:00-07:00 giờ VN. *@
    private string DeadlineValue => Ui.InputDate(
        Model.Deadline == default ? VietnamDateHelper.Today().AddMonths(1) : Model.Deadline);
}
