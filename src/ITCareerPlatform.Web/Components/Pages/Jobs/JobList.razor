@page "/jobs"
@attribute [Authorize(Roles = Roles.AdminOrMentor)]
@inject IJobService Jobs
@inject IApplicationService Applications

<div class="page-head">
    <h1 class="page-title">Tin tuyển dụng IT</h1>
    <a class="btn-primary" href="/jobs/new">+ Tạo tin tuyển dụng IT</a>
</div>
<p class="sub">Danh sách tin IT — có Danh mục, Tech Stack, Cấp bậc; sắp xếp theo ngày tạo mới nhất.</p>
@if (!string.IsNullOrEmpty(Err)) { <div class="alert-err">@Err</div> }

<table class="tbl">
    <thead>
        <tr><th>ID</th><th>Vị trí</th><th>Danh mục</th><th>Tech Stack</th><th>Cấp bậc</th><th>Hạn nộp</th><th>Số SV</th><th>Trạng thái</th><th>Thao tác</th></tr>
    </thead>
    <tbody>
        @foreach (var j in jobs)
        {
            var mine = isAdmin || j.CreatedById == uid;
            <tr>
                <td>@j.Id</td>
                <td>@j.Title</td>
                <td><span class="@Ui.CategoryClass(j.Category)">@j.Category</span></td>
                <td>
                    @{ var tags = j.TechStackList; }
                    @foreach (var tg in tags.Take(3)) { <span class="chip">@tg</span> }
                    @if (tags.Count > 3) { <span class="chip chip-more">+@(tags.Count - 3)</span> }
                </td>
                <td><span class="@Ui.LevelClass(j.Level)">@j.Level</span></td>
                <td>@Ui.DateText(j.Deadline)</td>
                <td><a href="@($"/jobs/{j.Id}/applicants")">@counts.GetValueOrDefault(j.Id)</a></td>
                <td>
                    @if (j.Status == JobStatus.Open) { <span class="ok">● Đang mở</span> }
                    else { <span class="lock">● Đã đóng</span> }
                </td>
                <td class="nowrap">
                    <a class="btn-sm" href="@($"/jobs/{j.Id}/applicants")">Ứng viên</a>
                    @if (!mine)
                    {
                        @* Tin của Mentor khác: chỉ xem. Trước đây nút Đóng/Mở lại hiện cho mọi
                           Mentor và endpoint cũng không kiểm tra quyền sở hữu, nên một cú bấm
                           là đóng được tin tuyển dụng của người khác. *@
                        <span class="sub">— (tin của người khác)</span>
                    }
                    else if (j.Status == JobStatus.Open)
                    {
                        <a class="btn-sm ghost" href="@($"/jobs/edit/{j.Id}")">Sửa</a>
                        <form method="post" action="@($"/jobs/{j.Id}/close")" class="inline" onsubmit="return confirm('Bạn chắc chắn muốn đóng tin tuyển dụng này?');">
                            <button class="btn-sm danger" type="submit">Đóng</button>
                        </form>
                    }
                    else
                    {
                        <span class="btn-sm ghost disabled" title="Mở lại tin trước khi sửa">Sửa</span>
                        <form method="post" action="@($"/jobs/{j.Id}/reopen")" class="inline">
                            <button class="btn-sm" type="submit">Mở lại</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (jobs.Count == 0) { <tr><td colspan="9" class="sub">Chưa có tin tuyển dụng.</td></tr> }
    </tbody>
</table>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }

    private List<Job> jobs = new();
    private Dictionary<int, int> counts = new();
    private int uid;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        jobs = Jobs.GetAll();
        // Đếm theo đúng những tin đang hiển thị thay vì gộp cả bảng Applications.
        counts = Applications.CountForJobs(jobs.Select(j => j.Id).ToList());

        if (AuthState is null) return;
        var user = (await AuthState).User;
        uid = CurrentUser.Id(user);
        isAdmin = CurrentUser.IsAdmin(user);
    }
}
