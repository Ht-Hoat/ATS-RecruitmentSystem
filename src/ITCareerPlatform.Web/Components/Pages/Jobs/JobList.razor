@page "/jobs"
@attribute [Authorize(Roles = Roles.AdminOrMentor)]
@inject IJobService Jobs
@inject IApplicationService Applications
@inject IUserService Users

<div class="page-head">
    <h1 class="page-title">Tin tuyển dụng IT</h1>
    @* Chỉ Mentor đăng tin — Admin giám sát, không tuyển dụng (JobService.Create cũng chặn). *@
    @if (!isAdmin)
    {
        <a class="btn-primary" href="/jobs/new">+ Tạo tin tuyển dụng IT</a>
    }
</div>
<p class="sub">
    @(isAdmin
        ? "Toàn bộ tin IT trong hệ thống (chỉ xem) — việc đăng, sửa, đóng tin và xử lý ứng viên do Mentor đăng tin thực hiện."
        : "Tin tuyển dụng do bạn đăng — có Danh mục, Tech Stack, Cấp bậc; sắp xếp theo ngày tạo mới nhất.")
</p>
@if (!string.IsNullOrEmpty(Err))
{
    <div class="alert-err">@Err</div>
}

<table class="tbl">
    <thead>
        <tr>
            <th>Vị trí</th>
            <th>Danh mục</th>
            <th>Tech Stack</th>
            <th>Cấp bậc</th>
            <th>Ngày tạo</th>
            <th>Hạn nộp</th>
            <th>Số SV</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var j in jobs)
        {
            @* P1-5: Mentor chỉ thấy tin của mình nên thao tác được mọi dòng. Admin thấy tất
               cả nhưng CHỈ XEM — nút thao tác bị ẩn, và endpoint/service cũng chặn. *@
            <tr>
                <td>
                    <b>@j.Title</b>
                    @if (mentorNames.TryGetValue(j.CreatedById, out var mentorName))
                    {
                        <div class="tag-muted">👤 @mentorName · Chỉ xem</div>
                    }
                </td>
                <td><span class="@Ui.CategoryClass(j.Category)">@j.Category</span></td>
                <td>
                    @{
                        var tags = j.TechStackList;
                    }
                    @foreach (var tg in tags.Take(3))
                    {
                        <span class="chip">@tg</span>
                    }
                    @if (tags.Count > 3)
                    {
                        <span class="chip chip-more">+@(tags.Count - 3)</span>
                    }
                </td>
                <td><span class="@Ui.LevelClass(j.Level)">@j.Level</span></td>
                <td>@j.Deadline.ToString("dd/MM/yyyy")</td>
                <td><a href="@($"/jobs/{j.Id}/applicants")">@counts.GetValueOrDefault(j.Id)</a></td>
                <td>@if (j.Status == "Open") {
                    <span class="ok">● Đang mở</span>
                } else
                {

                    <span class="lock">● Đã
                        đóng</span>
                    }
                </td>
                <td class="nowrap">
                    <a class="btn-sm" href="@($"/jobs/{j.Id}/applicants")">Ứng viên</a>
                    @if (j.Status == "Open")
                    {
                        <a class="btn-sm ghost" href="@($"/jobs/edit/{j.Id}")">Sửa</a>
                        <form method="post" action="@($"/jobs/{j.Id}/close")" class="inline"
                              onsubmit="return confirm('Bạn chắc chắn muốn đóng tin tuyển dụng này?');">
                            <button class="btn-sm danger" type="submit">Đóng</button>
                        </form>
                    }
                    else
                    {
                        <span class="btn-sm ghost disabled" title="Mở lại tin trước khi sửa">Sửa</span>
                        <form method="post" action="@($"/jobs/{j.Id}/reopen")" class="inline">
                            <button class="btn-sm" type="submit">Mở lại</button>
                        </form>
                    }
                </td>
            </tr>
        }
        @if (jobs.Count == 0)
        {
            <tr>
                <td colspan="9" class="sub">Chưa có tin tuyển dụng.</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [SupplyParameterFromQuery(Name = "err")] public string? Err { get; set; }

    private List<Job> jobs = new();
    private Dictionary<int, int> counts = new();
    protected override void OnInitialized()
    {
        jobs = Jobs.GetAll();
        counts = Applications.CountAllByJob(); // #2: đếm 1 lần thay vì N+1
    }
}
