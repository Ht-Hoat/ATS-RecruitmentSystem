@page "/cv-templates"
@attribute [Authorize(Roles = Roles.Student)]

@* ITC-02: Bộ sưu tập mẫu CV IT + Tips *@

<h1 class="page-title">Mẫu CV IT & Mẹo viết CV</h1>
<p class="sub">Tham khảo mẫu CV phù hợp ngành IT và các mẹo giúp CV nổi bật với nhà tuyển dụng.</p>

<div class="panel">
    <h2>📄 Bộ sưu tập mẫu CV</h2>
    <div class="link-grid">
        @foreach (var t in Templates)
        {
            <div class="cv-tpl">
                <div class="cv-tpl-thumb">@t.Icon</div>
                <b>@t.Name</b>
                <span class="sub">@t.Fit</span>
                <a class="btn-sm" href="@t.Url" target="_blank" rel="noopener">Tạo CV này</a>
            </div>
        }
    </div>
</div>

<div class="panel" style="margin-top:16px">
    <h2>💡 Mẹo viết CV IT</h2>
    <ul class="feat">
        @foreach (var tip in Tips) { <li>✅ @tip</li> }
    </ul>
</div>

@code {
    private record Tpl(string Name, string Fit, string Icon, string Url);

    private static readonly Tpl[] Templates =
    {
        new("Simple Clean", "Software Engineer", "🧑‍💻", "https://flowcv.com"),
        new("Modern Tech", "Full Stack Developer", "🛠️", "https://www.canva.com/resumes/templates/"),
        new("Data Focused", "Data Analyst / AI", "📊", "https://novoresume.com"),
        new("DevOps Pro", "DevOps Engineer", "⚙️", "https://flowcv.com"),
        new("Fresher Friendly", "Sinh viên mới ra trường", "🎓", "https://www.canva.com/resumes/templates/"),
        new("Minimal", "Mobile Developer", "📱", "https://novoresume.com"),
    };

    private static readonly string[] Tips =
    {
        "Luôn đặt link GitHub/Portfolio ở phần đầu CV — nhà tuyển dụng IT xem code trước tiên.",
        "Dùng động từ mạnh: Built, Deployed, Optimized, Automated... thay vì 'tham gia', 'hỗ trợ'.",
        "Ghi rõ Tech Stack trong mỗi dự án: 'React 18, Node.js 20, PostgreSQL 15' thay vì chỉ 'web'.",
        "Định lượng kết quả: 'giảm 40% thời gian tải trang', 'phục vụ 10k người dùng/ngày'.",
        "Giữ CV 1 trang với fresher, tối đa 2 trang — súc tích, dễ quét.",
        "Ưu tiên kỹ năng khớp với JD của vị trí đang ứng tuyển (đọc kỹ Tech Stack yêu cầu).",
        "Tránh lỗi chính tả và định dạng lộn xộn — lưu và gửi CV dạng PDF.",
        "Thêm mục dự án cá nhân (side project) nếu chưa nhiều kinh nghiệm làm việc.",
        "Đặt tên file rõ ràng: 'NguyenVanA_Backend_CV.pdf' thay vì 'cv_final_v3.pdf'.",
        "Cập nhật LinkedIn khớp với CV — nhà tuyển dụng thường tra cứu chéo.",
    };
}
